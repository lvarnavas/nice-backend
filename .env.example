# Copy this file to .env and fill in the values.
# Never commit the real .env — it is ignored by git.

# Port the API server listens on.
PORT=5001

# MySQL connection details.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mydb

# Secret used to sign JSON Web Tokens.
# Generate a fresh one with:  openssl rand -hex 32
# Use a different value per environment and never reuse the development secret in production.
JWT_SECRET=
